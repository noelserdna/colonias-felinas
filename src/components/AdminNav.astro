---
import Icon from "./Icon.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const groups: { title: string | null; links: [string, string][] }[] = [
  { title: null, links: [["/admin", "Resumen"]] },
  { title: "Personas", links: [["/admin/colonias", "Colonias"], ["/admin/usuarios", "Usuarios"], ["/admin/carnets", "Carnets"]] },
  { title: "Contenido", links: [["/admin/temarios", "Temarios"], ["/admin/temas", "Temas"], ["/admin/preguntas", "Preguntas"], ["/admin/documentos", "Documentos"], ["/admin/textos", "Textos"]] },
  { title: "Configuración", links: [["/admin/ajustes", "Ajustes"], ["/admin/programa", "Programa local"], ["/admin/accesibilidad", "Accesibilidad"]] },
];
// Coincidencia por segmento completo: /admin/colonia no marca /admin/colonias.
const isActive = (href: string) => (href === "/admin" ? path === "/admin" : path === href || path.startsWith(href + "/"));
const current = groups.flatMap((g) => g.links).find(([href]) => isActive(href))?.[1] ?? "Administración";
---
<nav class="admin-nav" aria-label="Administración">
  {/* Móvil: menú desplegable con la sección actual y todas las secciones agrupadas. */}
  <details class="admin-menu">
    <summary>
      <span class="admin-menu-label"><span class="muted text-sm">Sección:</span> <strong>{current}</strong></span>
      <span class="admin-menu-action">Cambiar <Icon name="arrow" size={16} class="admin-menu-caret" /></span>
    </summary>
    <div class="admin-menu-panel">
      {groups.map((g) => (
        <div class="admin-menu-group">
          {g.title && <p class="admin-menu-title">{g.title}</p>}
          <ul>
            {g.links.map(([href, label]) => (
              <li><a href={href} aria-current={isActive(href) ? "page" : undefined}>{label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </details>
  {/* Escritorio: todas las secciones a la vista. */}
  <ul class="admin-pills">
    {groups.flatMap((g) => g.links).map(([href, label]) => (
      <li><a href={href} aria-current={isActive(href) ? "page" : undefined}>{label}</a></li>
    ))}
  </ul>
</nav>
