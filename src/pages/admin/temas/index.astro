---
import Layout from "../../../layouts/Layout.astro";
import AdminNav from "../../../components/AdminNav.astro";
import TemarioSelector from "../../../components/TemarioSelector.astro";
import { asc, eq } from "drizzle-orm";
import { getDb, schema } from "../../../lib/db";
import { temarioElegido } from "../../../lib/temarios";

const db = getDb();
const temario = await temarioElegido(db, Astro.url.searchParams.get("temario"));
const units = await db.query.units.findMany({ where: eq(schema.units.temarioId, temario), orderBy: asc(schema.units.orden) });
const q = temario === Astro.locals.temario.id ? "" : `?temario=${encodeURIComponent(temario)}`;
---
<Layout title="Temas" wide>
  <p class="eyebrow">Administración</p>
  <h1>Temas</h1>
  <AdminNav />
  <TemarioSelector actual={temario} action="/admin/temas" />
  {units.length === 0 && <p class="muted">Este temario todavía no tiene temas.</p>}
  <div class="card table-scroll" hidden={units.length === 0}>
    <table class="data responsive">
      <thead><tr><th>Tema</th><th>Peso en examen final</th><th>Estado</th><th><span class="sr-only">Acciones</span></th></tr></thead>
      <tbody>
        {units.map((u) => (
          <tr>
            <td class="primary-cell">{u.orden}. {u.titulo}</td><td data-label="Peso">{u.peso}</td>
            <td data-label="Estado">{u.activo ? <span class="badge ok">activo</span> : <span class="badge lock">inactivo</span>}</td>
            <td class="actions"><a class="btn small" href={`/admin/temas/${u.id}`} aria-label={`Editar tema ${u.orden}`}>Editar</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <a class="btn primary" href={`/admin/temas/nuevo${q}`}>Nuevo tema</a>
</Layout>
