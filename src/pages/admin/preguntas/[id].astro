---
import Layout from "../../../layouts/Layout.astro";
import AdminNav from "../../../components/AdminNav.astro";
import { asc, eq } from "drizzle-orm";
import { ZodError } from "zod";
import { getDb, schema } from "../../../lib/db";
import { createQuestion, updateQuestion } from "../../../lib/admin";
import { getTemario, temarioElegido } from "../../../lib/temarios";

const db = getDb();
const isNew = Astro.params.id === "nueva";
const q = isNew ? null : await db.query.questions.findFirst({ where: eq(schema.questions.id, Number(Astro.params.id)) });
if (!isNew && !q) return new Response("No encontrada", { status: 404 });
// La pregunta se edita dentro de su temario (el de su tema; si es nueva, ?temario=… o el activo).
const qUnit = q ? await db.query.units.findFirst({ where: eq(schema.units.id, q.unitId) }) : null;
const temarioId = qUnit?.temarioId ?? (await temarioElegido(db, Astro.url.searchParams.get("temario")));
const temario = await getTemario(db, temarioId);
const units = await db.query.units.findMany({ where: eq(schema.units.temarioId, temarioId), orderBy: asc(schema.units.orden) });
const volver = `/admin/preguntas?temario=${encodeURIComponent(temarioId)}`;
let error: string | null = null;
let form: Record<string, string> = {};

const lines = (s: string) => s.split("\n").map((l) => l.trim()).filter(Boolean);

if (Astro.request.method === "POST") {
  form = Object.fromEntries([...(await Astro.request.formData()).entries()].map(([k, v]) => [k, String(v)]));
  const tipo = form.tipo as "mc" | "multi" | "written";
  const input = {
    // `tema` llega como id; se traduce al slug del tema dentro de este temario (nunca al orden: se repite entre temarios).
    tema: units.find((u) => u.id === Number(form.tema))?.slug ?? "",
    tipo,
    dificultad: (["baja", "media", "alta"].includes(form.dificultad) ? form.dificultad : "media") as "baja" | "media" | "alta",
    enunciado: form.enunciado,
    opciones: tipo !== "written" ? lines(form.opciones ?? "") : undefined,
    correcta: tipo === "mc" ? Number(form.correcta) - 1 : undefined,
    correctas: tipo === "multi" ? (form.correctas ?? "").split(/[\s,;|]+/).filter(Boolean).map((x) => Number(x) - 1) : undefined,
    explicacion: form.explicacion || null,
    respuesta_referencia: tipo === "written" ? form.respuesta_referencia : null,
    puntos_clave: tipo === "written" ? lines(form.puntos_clave ?? "") : null,
    activo: form.activo === "on",
  };
  try {
    if (isNew) {
      const id = await createQuestion(db, input, temarioId);
      return Astro.redirect(`/admin/preguntas/${id}?ok=1`, 303);
    }
    await updateQuestion(db, Number(Astro.params.id), input, temarioId);
    return Astro.redirect(`/admin/preguntas/${Astro.params.id}?ok=1`, 303);
  } catch (e) {
    error = e instanceof ZodError ? e.issues.map((i) => i.message).join(". ") : String((e as Error).message);
  }
}

const v = {
  tema: form.tema ?? String(q?.unitId ?? Astro.url.searchParams.get("tema") ?? units[0]?.id ?? ""),
  tipo: form.tipo ?? q?.type ?? "mc",
  dificultad: form.dificultad ?? q?.dificultad ?? "media",
  enunciado: form.enunciado ?? q?.enunciado ?? "",
  opciones: form.opciones ?? (q?.options ?? []).join("\n"),
  correcta: form.correcta ?? String((q?.correctIndex ?? 0) + 1),
  correctas: form.correctas ?? (q?.correctIndexes ?? []).map((i) => i + 1).join(", "),
  explicacion: form.explicacion ?? q?.explicacion ?? "",
  respuesta_referencia: form.respuesta_referencia ?? q?.referenceAnswer ?? "",
  puntos_clave: form.puntos_clave ?? (q?.keyPoints ?? []).join("\n"),
  activo: form.activo != null ? form.activo === "on" : (q?.activo ?? true),
};
---
<Layout title={isNew ? "Nueva pregunta" : `Pregunta ${q!.id}`} wide>
  <p class="eyebrow">Administración</p>
  <h1>{isNew ? "Nueva pregunta" : `Editar pregunta #${q!.id}`} {q && <small class="muted">v{q.version}</small>}</h1>
  <AdminNav />
  <p class="muted">Temario: <a href={volver}>{temario?.nombre ?? temarioId}</a>{temarioId === Astro.locals.temario.id ? " (activo)" : " (no activo)"}</p>
  {Astro.url.searchParams.has("ok") && !error && <div class="alert ok" role="status" tabindex="-1" data-focus-on-load>Guardada.</div>}
  {error && <div class="alert bad" role="alert" id="qform-error" tabindex="-1" data-focus-on-load>{error}</div>}
  <form method="post" class="card" id="qform">
    <div class="row">
      <div style="flex:3;min-width:min(220px,100%)"><label for="tema">Tema</label>
        <select id="tema" name="tema">{units.map((u) => <option value={u.id} selected={String(u.id) === v.tema}>{u.orden}. {u.titulo}</option>)}</select></div>
      <div style="flex:1;min-width:min(140px,100%)"><label for="tipo">Tipo</label>
        <select id="tipo" name="tipo"><option value="mc" selected={v.tipo === "mc"}>Tipo test (una correcta)</option><option value="multi" selected={v.tipo === "multi"}>Varias correctas</option><option value="written" selected={v.tipo === "written"}>Escrita (JEV)</option></select></div>
      <div style="flex:1;min-width:min(140px,100%)"><label for="dificultad">Dificultad</label>
        <select id="dificultad" name="dificultad">
          <option value="baja" selected={v.dificultad === "baja"}>Baja</option>
          <option value="media" selected={v.dificultad === "media"}>Media</option>
          <option value="alta" selected={v.dificultad === "alta"}>Alta</option>
        </select></div>
    </div>
    <label for="enunciado">Enunciado</label>
    <textarea id="enunciado" name="enunciado" required>{v.enunciado}</textarea>
    <div data-show="mc multi">
      <label for="opciones">Opciones (una por línea)</label>
      <textarea id="opciones" name="opciones">{v.opciones}</textarea>
    </div>
    <div data-show="mc">
      <label for="correcta">Número de la opción correcta</label>
      <input id="correcta" name="correcta" type="number" inputmode="numeric" min="1" value={v.correcta} style="max-width:8rem" />
    </div>
    <div data-show="multi">
      <label for="correctas">Números de las opciones correctas (separados por comas, p. ej. 1, 3)</label>
      <input id="correctas" name="correctas" type="text" inputmode="numeric" value={v.correctas} style="max-width:14rem" aria-describedby="correctas-help" />
      <p class="muted text-sm mb-0" id="correctas-help" style="margin-top:.3rem">Solo se da por buena si se marcan exactamente estas opciones. No pueden ser correctas todas.</p>
    </div>
    <div data-show="written">
      <label for="respuesta_referencia">Respuesta de referencia</label>
      <textarea id="respuesta_referencia" name="respuesta_referencia">{v.respuesta_referencia}</textarea>
      <label for="puntos_clave">Puntos clave que debe contener (uno por línea)</label>
      <textarea id="puntos_clave" name="puntos_clave">{v.puntos_clave}</textarea>
    </div>
    <label for="explicacion">Explicación (se muestra al repasar el test de tema)</label>
    <textarea id="explicacion" name="explicacion">{v.explicacion}</textarea>
    <label class="check"><input type="checkbox" name="activo" checked={v.activo} /> <span>Activa (puede salir en tests y exámenes)</span></label>
    <div class="row" style="margin-top:1rem">
      <button class="btn primary" type="submit">Guardar</button>
      <a class="btn ghost" href={volver}>Volver</a>
    </div>
    <p class="muted">Editar una pregunta no altera los intentos ya realizados: cada intento guarda una copia de la pregunta tal como se mostró.</p>
  </form>
  <script>
    function sync() {
      const tipo = (document.getElementById("tipo") as HTMLSelectElement | null)?.value;
      document.querySelectorAll<HTMLElement>("[data-show]").forEach((el) => (el.hidden = !(el.dataset.show ?? "").split(" ").includes(tipo ?? "")));
    }
    document.addEventListener("astro:page-load", () => {
      document.getElementById("tipo")?.addEventListener("change", sync);
      sync();
    });
  </script>
</Layout>
