---
import Layout from "../../../layouts/Layout.astro";
import AdminNav from "../../../components/AdminNav.astro";
import { getDb } from "../../../lib/db";
import { importQuestions } from "../../../lib/admin";
import { csvToInputs } from "../../../lib/questions-io";
import { getTemario, temarioElegido } from "../../../lib/temarios";

const db = getDb();
// Las preguntas se añaden a los temas del temario elegido (?temario=…, por defecto el activo).
const temarioId = await temarioElegido(db, Astro.url.searchParams.get("temario"));
const temario = await getTemario(db, temarioId);

let result: Awaited<ReturnType<typeof importQuestions>> | null = null;
let error: string | null = null;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const file = f.get("file");
  if (!(file instanceof File) || file.size === 0) error = "Selecciona un fichero.";
  else if (file.size > 2_000_000) error = "El fichero es demasiado grande (máx. 2 MB).";
  else {
    const text = await file.text();
    try {
      const raw = file.name.toLowerCase().endsWith(".json") ? JSON.parse(text) : csvToInputs(text);
      if (!Array.isArray(raw)) throw new Error("El JSON debe ser una lista de preguntas");
      result = await importQuestions(db, raw, temarioId);
    } catch (e) {
      error = `No se pudo leer el fichero: ${(e as Error).message}`;
    }
  }
}
---
<Layout title="Importar preguntas" wide>
  <p class="eyebrow">Administración</p>
  <h1>Importar preguntas</h1>
  <AdminNav />
  <p class="muted">Temario: <a href={`/admin/preguntas?temario=${encodeURIComponent(temarioId)}`}>{temario?.nombre ?? temarioId}</a>{temarioId === Astro.locals.temario.id ? " (activo)" : " (no activo)"}. Para importar un temario completo (temas y preguntas), usa <a href="/admin/temarios">Temarios</a>.</p>
  {error && <div class="alert bad" role="alert" tabindex="-1" data-focus-on-load>{error}</div>}
  {result && result.errors.length === 0 && <div class="alert ok" role="status" tabindex="-1" data-focus-on-load>Se han importado {result.imported} preguntas.</div>}
  {result && result.errors.length > 0 && (
    <div class="alert bad" role="alert" tabindex="-1" data-focus-on-load>
      No se ha importado nada porque hay {result.errors.length} filas con errores:
      <ul>{result.errors.slice(0, 50).map((e) => <li>Fila {e.fila}: {e.error}</li>)}</ul>
    </div>
  )}
  <form method="post" enctype="multipart/form-data" class="card" data-astro-reload>
    <label for="file">Fichero CSV o JSON</label>
    <input id="file" name="file" type="file" accept=".csv,.json,text/csv,application/json" required />
    <button class="btn primary" style="margin-top:1rem" type="submit">Importar</button>
  </form>
  <div class="card prose">
    <h2 class="mt-0">Formato CSV</h2>
    <p>Separador <code>;</code> o <code>,</code>, primera fila con cabeceras (el mismo formato que la exportación):</p>
    <pre style="overflow-x:auto">tema;tipo;dificultad;enunciado;opcion1;opcion2;opcion3;opcion4;opcion5;opcion6;correcta;explicacion;respuesta_referencia;puntos_clave;activo</pre>
    <ul>
      <li><code>tema</code>: número de orden o identificador del tema dentro de este temario.</li>
      <li><code>tipo</code>: <code>test</code> o <code>escrita</code>.</li>
      <li><code>dificultad</code>: <code>baja</code>, <code>media</code> o <code>alta</code> (si se deja vacía, <code>media</code>).</li>
      <li><code>correcta</code>: número de la opción correcta (1, 2, 3…), solo en tipo test.</li>
      <li><code>puntos_clave</code>: separados por <code>|</code>, solo en escritas.</li>
    </ul>
    <p>Las preguntas importadas se <strong>añaden</strong> al banco (no sustituyen a las existentes).</p>
  </div>
</Layout>
