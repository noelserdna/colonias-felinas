---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getDb } from "../../lib/db";
import { activeUnits } from "../../lib/temarios";
import { readingMinutes } from "../../lib/exam";
import { listDocuments } from "../../lib/documents";
import DocumentList from "../../components/DocumentList.astro";
import { getPage } from "../../lib/pages";

// Sin carnet, el temario (con progreso y tests) está en la pantalla principal.
if (!Astro.locals.hasCarnet) return Astro.redirect("/");
const db = getDb();
const docs = await listDocuments(db);
const units = await activeUnits(db, Astro.locals.temario.id);
const suplemento = (await getPage(db, "programa-local")).markdown;
---
<Layout title="Consulta">
  <p class="eyebrow">Consulta</p>
  <h1>Consulta</h1>
  <p class="muted">Ya tienes tu acreditación. Aquí tienes el temario del curso y los documentos del Ayuntamiento siempre que los necesites.</p>
  <h2>Temario del curso</h2>
  <ol class="consult-list">
    {units.map((u) => (
      <li>
        <a href={`/temario/${u.slug}`}>
          <span class="node">{u.orden}</span>
          <span class="step-body">
            <span class="step-title">{u.titulo}</span>
            <span class="step-sub"><Icon name="clock" size={14} /> {readingMinutes(u.contenido)} min de lectura</span>
          </span>
          <Icon name="arrow" size={18} />
        </a>
      </li>
    ))}
  </ol>
  {suplemento.trim() && (
    <a class="card end-cta" href="/temario/local">
      <span class="step-icon"><Icon name="book" size={26} /></span>
      <span class="grow">
        <strong>{Astro.locals.programa.suplemento_titulo}</strong>
        <span class="muted text-sm" style="display:block">Suplemento local · {readingMinutes(suplemento)} min de lectura</span>
      </span>
      <Icon name="arrow" />
    </a>
  )}
  <h2 id="documentos">Documentos del Ayuntamiento</h2>
  <DocumentList docs={docs} level={3} />
</Layout>
