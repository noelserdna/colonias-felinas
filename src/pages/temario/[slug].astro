---
import Layout from "../../layouts/Layout.astro";
import { isDemo } from "../../lib/demo";
import Icon from "../../components/Icon.astro";
import { and, eq } from "drizzle-orm";
import { getDb, schema } from "../../lib/db";
import { getProgress, readingMinutes } from "../../lib/exam";
import { activeUnits, findActiveUnitBySlug } from "../../lib/temarios";
import { renderMarkdown } from "../../lib/markdown";
import { getPage } from "../../lib/pages";

const db = getDb();
// Los administradores pueden revisar un tema de otro temario (?temario=…) sin activarlo: vista previa sin test.
const pedido = Astro.url.searchParams.get("temario");
const preview = Astro.locals.user!.role === "admin" && Boolean(pedido) && pedido !== Astro.locals.temario.id;
const unit = preview
  ? await db.query.units.findFirst({ where: and(eq(schema.units.temarioId, pedido!), eq(schema.units.slug, Astro.params.slug!), eq(schema.units.activo, true)) })
  : await findActiveUnitBySlug(db, Astro.params.slug!);
if (!unit) return new Response("No encontrado", { status: 404 });
const { units } = preview
  ? { units: (await activeUnits(db, pedido!)).map((u) => ({ id: u.id, slug: u.slug, orden: u.orden, titulo: u.titulo, passed: false, bestPct: null, unlocked: true, minutos: readingMinutes(u.contenido) })) }
  : await getProgress(db, Astro.locals.user!.id);
const p = units.find((u) => u.id === unit.id)!;
const q = preview ? `?temario=${encodeURIComponent(pedido!)}` : "";
// Los administradores pueden revisar cualquier tema aunque no lo tengan desbloqueado.
const consulta = Astro.locals.hasCarnet || preview;
if (!p.unlocked && !consulta && Astro.locals.user!.role !== "admin") return Astro.redirect("/");
const idx = units.findIndex((u) => u.id === unit.id);
const prev = units[idx - 1];
const next = units[idx + 1];
const html = renderMarkdown(unit.contenido);
// Los temas que remiten al ayuntamiento («Pregunta en tu ayuntamiento») enlazan al suplemento local, si lo hay.
const suplemento = unit.contenido.includes("Pregunta en tu ayuntamiento") && Boolean((await getPage(db, "programa-local")).markdown.trim());
---
<Layout title={unit.titulo} readingProgress>
  {preview ? (
    <a class="btn ghost small" href={`/admin/temas?temario=${encodeURIComponent(pedido!)}`} style="margin-left:-.6rem"><Icon name="back" size={18} /> Temas del panel</a>
  ) : (
    <a class="btn ghost small" href={consulta ? "/temario" : "/"} style="margin-left:-.6rem"><Icon name="back" size={18} /> {consulta ? "Consulta" : "Temario"}</a>
  )}
  <p class="eyebrow" style="margin-top:.6rem">Tema {unit.orden} de {units.length}</p>
  <h1>{unit.titulo}</h1>
  {preview && <div class="alert info" role="status">Vista previa de un temario que no está activo: el alumnado no lo ve.</div>}
  {isDemo() && Astro.url.searchParams.get("aprobado") && (
    <div class="alert ok" role="status" tabindex="-1" data-focus-on-load>Tema {Astro.url.searchParams.get("aprobado")} aprobado con el atajo de la demo. Este es el siguiente.</div>
  )}
  <div class="meta">
    <span><Icon name="clock" size={16} /> {p.minutos} min de lectura</span>
    {consulta ? null : p.passed ? <span class="badge ok"><Icon name="check" size={14} /> Aprobado{p.bestPct != null ? ` · ${p.bestPct}%` : ""}</span> : <a class="btn small ghost" href={`/temario/${unit.slug}/test`}>Ir directamente al test</a>}
  </div>
  <article class="card prose" set:html={html} />
  {suplemento && (
    <a class="card end-cta" href="/temario/local">
      <span class="step-icon"><Icon name="book" size={26} /></span>
      <span class="grow">
        <strong>{Astro.locals.programa.suplemento_titulo}</strong>
        <span class="muted text-sm" style="display:block">Las respuestas a «Pregunta en tu ayuntamiento» para {Astro.locals.branding.municipio}.</span>
      </span>
      <Icon name="arrow" />
    </a>
  )}
  {consulta ? (
    <div class="row" style="justify-content:space-between">
      {prev ? <a class="btn ghost" href={`/temario/${prev.slug}${q}`}><Icon name="back" size={18} /> {prev.titulo}</a> : <span></span>}
      {next && <a class="btn" href={`/temario/${next.slug}${q}`}>{next.titulo} <Icon name="arrow" size={18} /></a>}
    </div>
  ) : (
  <div class="card end-cta">
    <span class="step-icon"><Icon name="exam" size={26} /></span>
    <div style="flex:1">
      <strong>{p.passed ? "Puedes repetir el test cuando quieras" : "¿Has terminado de estudiar el tema?"}</strong>
      <p class="muted" style="margin:.2rem 0 .8rem">{p.passed ? "Las preguntas cambian en cada intento." : "Aprueba el test para desbloquear el siguiente tema."}</p>
      <div class="row">
        <a class="btn primary" href={`/temario/${unit.slug}/test`}>Hacer el test <Icon name="arrow" /></a>
        {prev && <a class="btn ghost" href={`/temario/${prev.slug}`}><Icon name="back" size={18} /> Tema anterior</a>}
      </div>
    </div>
  </div>
  )}
  <dialog class="lightbox" aria-label="Imagen ampliada">
    <form method="dialog"><button class="btn small"><span aria-hidden="true">✕</span> Cerrar</button></form>
    <img alt="" />
    <p class="muted"></p>
  </dialog>
  <script>
    // Al tocar una imagen del temario se muestra ampliada.
    document.addEventListener("astro:page-load", () => {
      const dlg = document.querySelector<HTMLDialogElement>("dialog.lightbox");
      if (!dlg) return;
      const big = dlg.querySelector("img")!;
      const cap = dlg.querySelector("p")!;
      let opener: HTMLButtonElement | null = null;
      // Cada imagen va dentro de un botón para poder ampliarla también con el teclado.
      document.querySelectorAll<HTMLImageElement>(".prose img").forEach((img) => {
        if (img.parentElement?.classList.contains("zoom")) return;
        const b = document.createElement("button");
        b.type = "button";
        b.className = "zoom";
        b.setAttribute("aria-label", img.alt ? `Ampliar imagen: ${img.alt}` : "Ampliar imagen");
        img.replaceWith(b);
        b.appendChild(img);
        b.addEventListener("click", () => {
          opener = b;
          big.src = img.currentSrc || img.src;
          big.alt = img.alt;
          cap.textContent = img.closest("figure")?.querySelector("figcaption")?.textContent ?? "";
          dlg.showModal();
        });
      });
      dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });
      // Devolver el foco al botón que abrió la imagen.
      dlg.addEventListener("close", () => { opener?.focus(); opener = null; });
    });
  </script>
</Layout>
